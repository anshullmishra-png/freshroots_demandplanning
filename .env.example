# Names only. Never put real values here. Copy to .env.local (git-ignored) and fill there.
# See docs/11-DEPLOYMENT-AND-ENV.md

# Database (Neon Postgres)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# AI (server only, never exposed to the client)
GEMINI_API_KEY=
GEMINI_MODEL=

# Auth
AUTH_SECRET=

# App
APP_URL=

# Email (console provider in dev)
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=

# Scheduled job (Kill 2 daily check)
CRON_SECRET=

# Zoho Inventory (later, not used in the first release)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_DC=
