# Names only. Never put real values here. Copy to .env.local (git-ignored) and fill there.
# See docs/11-DEPLOYMENT-AND-ENV.md

# Database (Neon Postgres)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# AI (server only, never exposed to the client)
GEMINI_API_KEY=
GEMINI_MODEL=

# Auth
AUTH_SECRET=

# App
APP_URL=

# Email (console provider in dev)
EMAIL_PROVIDER=console
EMAIL_API_KEY=
EMAIL_FROM=

# Scheduled job (Kill 2 daily check)
CRON_SECRET=

# Tests only. AI_CLIENT=mock replaces Gemini with a script; it is refused on a Vercel production deployment.
AI_CLIENT=
# End-to-end test (docs/14): the test database, a deployed preview to test, and Vercel's automation bypass secret
E2E_DATABASE_URL=
E2E_BASE_URL=
VERCEL_AUTOMATION_BYPASS_SECRET=

# Zoho Inventory (later, not used in the first release)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORG_ID=
ZOHO_DC=

# Open demo link (throwaway preview ONLY): 1 lets visitors sign in as a test account with no password. Ignored on production.
DEMO_OPEN_ACCESS=
